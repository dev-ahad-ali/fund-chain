# Server-only secrets. Provide real values in .env.local or in your host's
# environment variable settings (Vercel → Settings → Environment Variables).
MONGODB_URI=

# Public configuration (safe for the client bundle).
NEXT_PUBLIC_CHAIN_ID=11155111
# Address of the CrowdfundingDemo contract deployed to Sepolia via Hardhat
# (see contracts/).
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Server-only Sepolia JSON-RPC endpoint such as an Alchemy/Infura URL used by
# the verification route handler. When empty, a managed public Sepolia RPC is
# used as a fallback.
SEPOLIA_RPC_URL=
